+func buildTLSOpts(tlsConf TLSConfig) []func(*tls.Config) {
+	opts := []func(*tls.Config){
+		WithClientAuth(tlsConf.WantCliAuth),
+	}
+	if tlsOpt := tlsProfileOpt(tlsConf.MinTLSVersion, tlsConf.CipherSuites); tlsOpt != nil {
+		opts = append(opts, tlsOpt)
+	}
+	return opts
+}
+
+func tlsProfileOpt(minVersion, cipherSuitesStr string) func(*tls.Config) {
+	minVer := parseTLSVersion(minVersion)
+	if minVer == 0 && cipherSuitesStr == "" {
+		return nil
+	}
+	var cipherSuites []uint16
+	if cipherSuitesStr != "" {
+		names := strings.Split(cipherSuitesStr, ",")
+		for i := range names {
+			names[i] = strings.TrimSpace(names[i])
+		}
+		cipherSuites = cipherSuiteIDs(names)
+	}
+	return func(c *tls.Config) {
+		if minVer != 0 {
+			c.MinVersion = minVer
+		}
+		if len(cipherSuites) > 0 && minVer != tls.VersionTLS13 {
+			c.CipherSuites = cipherSuites
+		}
+	}
+}
+
+func parseTLSVersion(s string) uint16 {
+	switch strings.TrimSpace(s) {
+	case "VersionTLS10", "TLS1.0":
+		return tls.VersionTLS10
+	case "VersionTLS11", "TLS1.1":
+		return tls.VersionTLS11
+	case "VersionTLS12", "TLS1.2":
+		return tls.VersionTLS12
+	case "VersionTLS13", "TLS1.3":
+		return tls.VersionTLS13
+	default:
+		return 0
+	}
+}
+
+var cipherSuiteByName map[string]uint16
+
+func init() {
+	cipherSuiteByName = make(map[string]uint16)
+	for _, cs := range tls.CipherSuites() {
+		cipherSuiteByName[cs.Name] = cs.ID
+	}
+}
+
+func cipherSuiteIDs(names []string) []uint16 {
+	var ids []uint16
+	for _, name := range names {
+		name = strings.TrimSpace(name)
+		if id, ok := cipherSuiteByName[name]; ok {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
